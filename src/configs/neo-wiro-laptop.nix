{
  self,
  inputs,
  withSystem,
  ...
}:
{
  flake.nixosConfigurations.neo-wiro-laptop = withSystem "x86_64-linux" (
    { pkgs, ... }:
    inputs.nixpkgs.lib.nixosSystem {
      inherit pkgs;
      modules = [
        self.nixosProfile.laptop

        self.nixosFragment.secureBoot
      ];
      config = [
        ({ ... }: {
          config = {
            system.stateVersion = "23.05";
            time.timeZone = "Europe/Paris";
          };
        })

        # Disko configuration
        ({ ... }: {
          imports = [
            inputs.disko.nixosModules.disko
            self.diskoConfigurations.luks-btrfs
          ];
        })

        # Generated by `nixos-generate-config`
        ({ lib, config, ... }: {
          config = {
            boot.initrd.availableKernelModules = [
              "xhci_pci"
              "thunderbolt"
              "vmd"
              "nvme"
              "sdhci_pci"
            ];
            boot.initrd.kernelModules = [ ];
            boot.kernelModules = [ "kvm-intel" ];
            boot.extraModulePackages = [ ];

            networking.useDHCP = lib.mkDefault true;

            nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
            hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;

            # Replaces `<modules>/installer/scan/not-detected.nix` import
            hardware.enableRedistributableFirmware = lib.mkDefault true;
          };
        })
      ];
    }
  );
}
