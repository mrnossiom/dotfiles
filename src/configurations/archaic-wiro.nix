{
  self,
  inputs,
  withSystem,
  ...
}:
{
  flake.nixosConfigurations.archaic-wiro = withSystem "x86_64-linux" (
    { pkgs, upkgs, ... }:
    inputs.nixpkgs.lib.nixosSystem {
      inherit pkgs;
      specialArgs = { inherit upkgs; };
      modules = [
        self.modules.nixos.profile-laptop

        ({ ... }: {
          config = {
            system.stateVersion = "23.05";
            time.timeZone = "Europe/Paris";

            networking.hostName = "archaic-wiro";

            local.user = {
              username = "milomoisson";
              description = "Milo Moisson";
              shell = pkgs.fish;
              profile = "desktop";
              elevated = true;
              keys = self.keys.users;
            };
          };
        })

        # Generated by `nixos-generate-config`
        ({ lib, config, ... }: {
          config = {
            boot.initrd.availableKernelModules = [
              "xhci_pci"
              "ahci"
              "sd_mod"
              "rtsx_pci_sdmmc"
            ];
            boot.initrd.kernelModules = [ ];
            boot.kernelModules = [ "kvm-intel" ];
            boot.extraModulePackages = [ ];

            fileSystems."/" = {
              device = "/dev/disk/by-uuid/c3e74034-2dc2-4462-a4f1-82fc5f8e7daf";
              fsType = "ext4";
            };

            fileSystems."/boot" = {
              device = "/dev/disk/by-uuid/A18B-9B1D";
              fsType = "vfat";
            };

            swapDevices = [
              { device = "/dev/disk/by-uuid/6206464f-5261-404c-b2f5-dbb450d30550"; }
            ];

            networking.useDHCP = lib.mkDefault true;

            nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
            powerManagement.cpuFreqGovernor = lib.mkDefault "powersave";
            hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;

            # Replaces `<modules>/installer/scan/not-detected.nix` import
            hardware.enableRedistributableFirmware = lib.mkDefault true;
          };
        })
      ];
    }
  );
}
