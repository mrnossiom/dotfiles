{
  self,
  inputs,
  withSystem,
  ...
}:
{
  flake.nixosConfigurations.weird-row = withSystem "x86_64-linux" (
    { pkgs, upkgs, ... }:
    inputs.nixpkgs.lib.nixosSystem {
      inherit pkgs;
      specialArgs = { inherit upkgs; };
      modules = [
        inputs.srvos.nixosModules.server
        inputs.srvos.nixosModules.hardware-hetzner-cloud
        inputs.srvos.nixosModules.mixins-terminfo

        ({ ... }: {
          imports = with self.modules.nixos; [
            option-ports
            agenix
            nix

            weird_row-agnos
            weird_row-authelia
            weird_row-bluesky-pds
            weird_row-caddy
            weird_row-caddy-tailscale
            weird_row-gatus
            weird_row-goatcounter
            weird_row-grafana
            weird_row-headscale
            weird_row-hedgedoc
            weird_row-hypixel-bank-tracker
            weird_row-lldap
            weird_row-miniflux
            weird_row-ripe-atlas
            weird_row-rustical
            weird_row-storage-box
            weird_row-tailscale
            weird_row-tangled
            weird_row-vaultwarden
            weird_row-warrior
          ];

          config = {
            system.stateVersion = "24.11";
            time.timeZone = "Europe/Berlin";

            networking.hostName = "weird-row";

            users.users.root.openssh.authorizedKeys.keys = self.keys.users;

            boot.loader.grub.enable = true;

            networking.nameservers = [
              "2001:4860:4860::8888"
              "2001:4860:4860::8844"
            ];

            # Single network card is `eth0`
            networking.usePredictableInterfaceNames = false;
            systemd.network.networks."40-eth0" = {
              matchConfig.Name = "eth0";
              address = with self.globals.network; [
                weird-row-v4-server.address
                weird-row-v6-server.address
                weird-row-v6-agnos.address
              ];
              routes = [
                {
                  Gateway = "172.31.1.1";
                  GatewayOnLink = true;
                }
                { Gateway = "fe80::1"; }
              ];
              linkConfig.RequiredForOnline = "routable";
            };
            # wrote a file in /etc/systemd/networking/ that override networking.interfaces
            services.cloud-init.network.enable = false;

            services.qemuGuest.enable = true;

            networking.firewall.enable = true;

            local.ports.openssh = {
              number = 22;
              public = true;
            };
            services.openssh.enable = true;

            services.fail2ban = {
              enable = true;

              maxretry = 5;
              ignoreIP = [ ];

              bantime = "24h";
              bantime-increment = {
                enable = true;
                multipliers = "1 2 4 8 16 32 64";
                maxtime = "168h";
                overalljails = true;
              };

              jails = { };
            };
          };
        })

        # Disko configuration
        inputs.disko.nixosModules.disko
        self.diskoConfigurations.hetzner-ext4

        # Generated by `nixos-generate-config`
        ({ lib, modulesPath, ... }: {
          imports = [ "${modulesPath}/profiles/qemu-guest.nix" ];

          config = {
            boot.initrd.availableKernelModules = [
              "ahci"
              "xhci_pci"
              "virtio_pci"
              "virtio_scsi"
              "sd_mod"
              "sr_mod"
            ];
            boot.initrd.kernelModules = [ ];
            boot.kernelModules = [ ];
            boot.extraModulePackages = [ ];
          };
        })
      ];
    }
  );
}
